// =========================================================================
// Title: Ingress Tool Transfer via Certutil (LOLBAS)
// Severity: High
// Tactic: Execution / Defense Evasion
// Technique: Ingress Tool Transfer (T1105) / System Binary Proxy Execution (T1218)
// Data Source: Sysmon Event ID 1 (Process Creation)
// Description: Identifies execution of certutil.exe with flags commonly abused
//              by threat actors to download secondary stage payloads or bypass perimeter controls.
// =========================================================================

Event
| where Source == "Microsoft-Windows-Sysmon" and EventID == 1
| extend EventData = parse_xml(EventData)
| extend 
    CommandLine = tostring(EventData.DataItem.EventData.Data[10].["#text"]),
    Image = tostring(EventData.DataItem.EventData.Data[4].["#text"]),
    ParentImage = tostring(EventData.DataItem.EventData.Data[20].["#text"]),
    User = tostring(EventData.DataItem.EventData.Data[11].["#text"]),
    ProcessId = tostring(EventData.DataItem.EventData.Data[3].["#text"]),
    Hashes = tostring(EventData.DataItem.EventData.Data[16].["#text"])
| where Image endswith "certutil.exe"
| where CommandLine has_any ("-urlcache", "-split", "http://", "https://", "ftp://")
| project 
    TimeGenerated, 
    Computer, 
    User, 
    Image, 
    CommandLine, 
    ParentImage, 
    ProcessId, 
    Hashes
| extend 
    AccountCustomEntity = User,
    HostCustomEntity = Computer
