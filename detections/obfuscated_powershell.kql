// =========================================================================
// Title: Suspicious Encoded / Hidden PowerShell Command Execution
// Severity: High
// Tactic: Execution / Defense Evasion
// Technique: Command and Scripting Interpreter: PowerShell (T1059.001) / Deobfuscate/Decode Files or Information (T1140)
// Data Source: Sysmon Event ID 1 (Process Creation)
// Description: Detects PowerShell executions utilizing base64 encoding flags (-enc, -encodedcommand),
//              window-hiding arguments (-w hidden), and bypass flags (-nop, -ep bypass).
// =========================================================================

Event
| where Source == "Microsoft-Windows-Sysmon" and EventID == 1
| extend EventData = parse_xml(EventData)
| extend 
    CommandLine = tostring(EventData.DataItem.EventData.Data[10].["#text"]),
    Image = tostring(EventData.DataItem.EventData.Data[4].["#text"]),
    ParentImage = tostring(EventData.DataItem.EventData.Data[20].["#text"]),
    User = tostring(EventData.DataItem.EventData.Data[11].["#text"]),
    ProcessId = tostring(EventData.DataItem.EventData.Data[3].["#text"])
| where Image endswith "powershell.exe" or Image endswith "pwsh.exe"
| where (CommandLine has_any ("-enc", "-encodedcommand", "-e ") and CommandLine has_any ("-nop", "-noprofile", "-w hidden", "-windowstyle hidden", "-ep bypass", "-executionpolicy bypass"))
| project 
    TimeGenerated, 
    Computer, 
    User, 
    Image, 
    CommandLine, 
    ParentImage, 
    ProcessId
| extend 
    AccountCustomEntity = User,
    HostCustomEntity = Computer
