// =========================================================================
// Title: Unauthorized Local Administrator Account Creation & Privilege Escalation
// Severity: Medium
// Tactic: Persistence / Privilege Escalation
// Technique: Create Account: Local Account (T1136.001) / Account Manipulation (T1098)
// Data Source: Windows Security Events (EventID 4720, 4728, 4732)
// Description: Detects creation of new local user accounts or addition of accounts
//              to privileged local groups (e.g., Administrators).
// =========================================================================

SecurityEvent
| where TimeGenerated >= ago(2h)
| where EventID in (4720, 4728, 4732)
// 4720: User account created
// 4728: Member added to security-enabled global group
// 4732: Member added to security-enabled local group (Administrators)
| extend 
    ActorAccount = SubjectUserName,
    TargetUser = TargetUserName,
    GroupModified = TargetSid
| where TargetUser !in ("DefaultAccount", "WDAGUtilityAccount")
| project 
    TimeGenerated, 
    Computer, 
    EventID, 
    Activity, 
    ActorAccount, 
    TargetUser, 
    GroupModified
| extend 
    AccountCustomEntity = TargetUser,
    HostCustomEntity = Computer
